<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/back"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/backarrow"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.023"
            app:srcCompat="@drawable/barrow" />
        <!-- App Icon -->
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Icon"
            android:layout_marginBottom="16dp" />

        <!-- App Name -->
        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AccessMaster"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- App Version -->
        <TextView
            android:id="@+id/app_version"
            android:layout_width="wrap_content"
            android:layout_height="41dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="Version: 1.0"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- About Description -->
        <TextView
            android:id="@+id/about_description"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginBottom="16dp"
            android:text="AccessMaster is an offline assistant that lets you control your phone via SMS commands without the internet. You can locate your phone, change sound profiles, access contacts, and make it ring, all while ensuring security and efficiency."
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Features Heading -->
        <TextView
            android:id="@+id/features_heading"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginBottom="8dp"
            android:text="Key Features:"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Features List -->
        <TextView
            android:id="@+id/features_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Access contacts via SMS\n• Locate your phone\n• Change sound profile remotely\n• Lock your phone\n• Automatic responses."
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
